---
# Deployment-specific variables — copy to env.yml and set values for your
# environment. env.yml is gitignored — never commit it.
#
# domain, vault_addr, and the vault_kv_* vars come from
# ../../../inventory-common (a second inventory source in ansible.cfg) and
# do NOT need to be set here.

# ---- phpIPAM ----
# API application "ansible" must exist in phpIPAM under Administration >
# API first — see mgcdrd.infrasvc.phpipam_config's README.
vm_migrate_phpipam_url:    "https://dns1.{{ domain }}" # confirm against your actual phpIPAM URL
vm_migrate_phpipam_app_id: "ansible"

# ---- Foreman ----
vm_migrate_foreman_url: "https://foreman.{{ domain }}"

# ---- ProxMox ----
# Which PVE node's API this deployment talks to. Any node can manage the
# whole cluster via its API (state is synced cluster-wide via
# corosync/pmxcfs) — one fixed node works regardless of which node
# actually hosts the VM being migrated.
vm_migrate_pve_node: pve2

# Non-secret connection vars mgcdrd.infrabase's proxmox_* roles read
# directly — the collection has no defaults for these (infrabase >= 0.15.0),
# so this deployment sets them once, here. proxmox_api_host is set per-task
# in site.yml from vm_migrate_pve_node above, not here.
proxmox_api_user: root@pam
proxmox_validate_certs: false
